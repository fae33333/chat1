# مفتاح YouTube Data API v3 (للبحث عن المقاطع عند نشر منشور يوتيوب)
# أنشئه من: https://console.cloud.google.com  ->  APIs & Services  ->  YouTube Data API v3  ->  Credentials
YOUTUBE_API_KEY=

# إعدادات إرسال رمز التحقق عبر Gmail (SMTP)
# أنشئ "كلمة مرور تطبيق" (App Password) لحساب Gmail المرسل من: https://myaccount.google.com/apppasswords
# إن تركتها فارغة فاضبط الإعدادات من لوحة الإدارة (/admin) بدلاً من ذلك
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
