# مفتاح YouTube Data API v3 (للبحث عن المقاطع عند نشر منشور يوتيوب)
# أنشئه من: https://console.cloud.google.com  ->  APIs & Services  ->  YouTube Data API v3  ->  Credentials
# يمكنك تركه فارغاً — البحث سيعمل تلقائياً عبر البديل المجاني (Innertube)، لكن المفتاح يعطي نتائج أدق وحصة 10,000 طلب يومياً
# كما يمكنك إضافة المفتاح لاحقاً من لوحة الإدارة /admin → إعدادات يوتيوب بدون إعادة تشغيل
YOUTUBE_API_KEY=

# إعدادات إرسال رمز التحقق عبر Gmail (SMTP)
# أنشئ "كلمة مرور تطبيق" (App Password) لحساب Gmail المرسل من: https://myaccount.google.com/apppasswords
# إن تركتها فارغة فاضبط الإعدادات من لوحة الإدارة (/admin) بدلاً من ذلك
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# المنفذ (اختياري)
PORT=3000
HTTPS_PORT=2083

# ---- يوتيوب: عند ظهور "Sign in to confirm you're not a bot" ----
# بيانات دخول اختيارية بصيغة Netscape؛ املأها محلياً على الخادم ولا ترفع قيمها للمستودع.
YTDLP_COOKIES=
# أو استخدم متصفحاً متاحاً على الخادم، مثال: firefox
YTDLP_COOKIES_FROM_BROWSER=
# عنوان بروكسي موثوق اختياري
YTDLP_PROXY=
# قائمة خوادم Piped البديلة (مفصولة بفاصلة)
# PIPED_INSTANCES=https://pipedapi.kavin.rocks,https://pipedapi.adminforge.de

# ---- حفظ أغاني يوتيوب كملف MP3 صغير ----
# يتطلب ffmpeg على الخادم (Ubuntu/Debian: apt install ffmpeg).
# FFMPEG_PATH=/usr/bin/ffmpeg
# أقل جودة صوت من يوتيوب + MP3 مونو منخفض الحجم؛ القيمة الافتراضية 32k.
# YT_MP3_BITRATE=32k
# أقصى مدة للمقطع بالثواني (افتراضي 1500 = 25 دقيقة)
# YT_MAX_SECONDS=1500

# --- بحث يوتيوب ---
# الأضمن على الاستضافات التي تحجب يوتيوب: مفتاح YouTube Data API v3 (googleapis.com غير محجوب عادةً)
# YOUTUBE_API_KEY=AIza...
# نسخ Invidious بديلة (اختياري، مفصولة بفواصل)
# YT_INVIDIOUS_INSTANCES=https://yewtu.be,https://inv.nadeko.net

# ---- التسجيل عبر حساب Google (شاشة «اختيار حساب» الكاملة) ----
# 1) https://console.cloud.google.com ← APIs & Services ← OAuth consent screen: اكتب اسم التطبيق (SoulChill) ← يظهر في «المتابعة إلى ...»
# 2) Credentials ← Create Credentials ← OAuth client ID ← Web application
# 3) أضف في Authorized redirect URIs عنوان العودة بالضبط (يمكن إضافة عدة عناوين، سطر لكل عنوان):
#      https://yourdomain.com/api/auth/google/callback
#      https://yourdomain.com:2083/api/auth/google/callback     ← إن كان موقعك على منفذ HTTPS مخصص
#      http://localhost:3000/api/auth/google/callback            ← للتجربة المحلية
#    ⚠️ أي فرق بسيط (http/https، www، منفذ، شرطة مائلة نهائية) يسبب الخطأ:
#       400 redirect_uri_mismatch — الأسهل: انسخ العنوان المعروض في لوحة الإدارة /admin ← تبويب Google
# 4) في Authorized JavaScript origins أضف أصل الموقع (مثال: https://yourdomain.com بدون مسار)
#    — هذا كافٍ لزر Google المنبثق الذي لا يستخدم redirect_uri أصلاً.
# 5) انسخ Client ID و Client secret هنا. إن تُركا فارغين يختفي زر Google ويبقى التسجيل برمز Gmail.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# اختياري: عناوين العودة (عنوان واحد أو عدة عناوين مفصولة بفاصلة/سطر).
# ضعه فقط إن كان الخادم خلف بروكسي ولم يطابق العنوان المحسوب تلقائياً ما هو مسجّل في Google Console
# GOOGLE_REDIRECT_URI=https://yourdomain.com/api/auth/google/callback
